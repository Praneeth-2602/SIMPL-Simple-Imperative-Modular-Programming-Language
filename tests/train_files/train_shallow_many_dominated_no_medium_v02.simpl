let i1 be 1
let a1 be 9
let b1 be 10
let c1 be 11
let q1 be queue
while i1 > 0 do
    set a1 to a1 + b1
    enqueue q1 9
    set b1 to b1 - c1
    enqueue q1 10
    set c1 to a1 + c1
    dequeue q1
    set a1 to c1 - b1
    enqueue q1 12
    set b1 to a1 + b1
    enqueue q1 13
    set c1 to c1 - a1
    dequeue q1
    enqueue q1 15
    set i1 to 0
end
